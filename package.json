{
  "name": "partnerlens",
  "version": "0.1.0",
  "description": "Ambient context cue detector for Even Realities G2 smart glasses",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "simulator": "npx evenhub-simulator -g http://localhost:5173",
    "package": "npx evenhub pack app.json dist -o partnerlens.ehpk"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.10"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "latest",
    "@evenrealities/evenhub-simulator": "latest",
    "typescript": "~5.6.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
